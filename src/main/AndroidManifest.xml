<?xml version="1.0" encoding="UTF-8"?>
<!--
  Attendance AI — application manifest.

  Declares the app, grants the camera permission and marks the entry
  activity. All UI is constructed programmatically in Java (no XML layouts).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" />

    <application android:label="@string/app_name"
                 android:icon="@mipmap/ic_launcher"
                 android:theme="@style/Theme.AttendanceAI">
        <activity android:name="org.attendanceai.ui.AttendanceActivity"
                  android:label="@string/activity_name"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 1 security gate: seed-phrase setup / PIN + biometric lock.
             Returns RESULT_OK to the caller after unlock or completed setup. -->
        <activity android:name="org.attendanceai.presentation.lockscreen.LockScreenActivity"
                  android:label="@string/activity_name"
                  android:theme="@style/Theme.AttendanceAI"
                  android:exported="false" />

        <!-- Item 2 navigation shell: Reports / Settings placeholders reachable
             from the Home screen's menu. Their companions are also the
             re-auth-gated recovery-phrase explanation screen. Not exported:
             they are only ever launched from the unlocked Home screen. -->
        <activity android:name="org.attendanceai.ui.ReportsActivity"
                  android:label="@string/activity_name"
                  android:theme="@style/Theme.AttendanceAI"
                  android:exported="false" />
        <activity android:name="org.attendanceai.ui.SettingsActivity"
                  android:label="@string/activity_name"
                  android:theme="@style/Theme.AttendanceAI"
                  android:exported="false" />
        <activity android:name="org.attendanceai.ui.RecoveryPhraseActivity"
                  android:label="@string/activity_name"
                  android:theme="@style/Theme.AttendanceAI"
                  android:exported="false" />
    </application>

</manifest>
