<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground — face-capture glyph: four viewfinder corners
  around a person silhouette (the app recognises a face and records the
  attendance punch). All content sits inside the adaptive-icon safe zone
  (center 66 x 66 of the 108 x 108 canvas), so Nothing OS / any launcher
  mask can crop the edges without clipping the glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Viewfinder corners -->
    <path
        android:pathData="M32,45 L32,37 Q32,32 37,32 L45,32"
        android:fillColor="#00000000"
        android:strokeColor="#1B1F3B"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M63,32 L71,32 Q76,32 76,37 L76,45"
        android:fillColor="#00000000"
        android:strokeColor="#1B1F3B"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M76,63 L76,71 Q76,76 71,76 L63,76"
        android:fillColor="#00000000"
        android:strokeColor="#1B1F3B"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M45,76 L37,76 Q32,76 32,71 L32,63"
        android:fillColor="#00000000"
        android:strokeColor="#1B1F3B"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- Head -->
    <path
        android:pathData="M45,49 A9,9 0 1,0 63,49 A9,9 0 1,0 45,49 Z"
        android:fillColor="#1B1F3B" />

    <!-- Shoulders -->
    <path
        android:pathData="M39,70 C39,61 45.5,56.5 54,56.5 C62.5,56.5 69,61 69,70 Z"
        android:fillColor="#1B1F3B" />
</vector>