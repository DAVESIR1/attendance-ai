<?xml version="1.0" encoding="utf-8"?>
<!--
  App theme. Required: AppCompatActivity (AttendanceActivity) crashes at
  startup without a Theme.AppCompat descendant. Dark window background matches
  the programmatic UI (white/light text on dark).
-->
<resources>
    <style name="Theme.AttendanceAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
