<?xml version="1.0" encoding="utf-8"?>
<!--
  App theme. Required: AppCompatActivity (AttendanceActivity) crashes at
  startup without a Theme.AppCompat descendant. The light window background
  keeps the classic shell consistent with the Compose lock screen.
-->
<resources>
    <style name="Theme.AttendanceAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/attendance_background</item>
        <item name="android:statusBarColor">@color/attendance_status_bar</item>
        <item name="android:navigationBarColor">@color/attendance_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
